[Unit]
Description=Sentiment RAG Bot (FastAPI)
After=network.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/sentiment-rag-bot
Environment="PATH=/home/ubuntu/sentiment-rag-bot/venv/bin"
ExecStart=/home/ubuntu/sentiment-rag-bot/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 2
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target

# Install with:
#   sudo cp deploy/sentiment-bot.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now sentiment-bot
#   sudo systemctl status sentiment-bot
